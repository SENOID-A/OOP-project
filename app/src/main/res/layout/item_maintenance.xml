<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp"
    app:strokeColor="@color/line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <TextView android:id="@+id/maintenanceVehicle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="ABC-123" android:textColor="@color/ink" android:textStyle="bold" android:textSize="15sp" />
        <TextView android:id="@+id/maintenanceDescription" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Scheduled maintenance" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="6dp" />
        <TextView android:id="@+id/maintenanceStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="SCHEDULED" android:textColor="@color/orange" android:textSize="9sp"
            android:textStyle="bold" android:background="@drawable/bg_status_neutral"
            android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_marginTop="10dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
