<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="11dp"
    app:cardBackgroundColor="@color/white" app:cardCornerRadius="17dp" app:cardElevation="0dp"
    app:strokeColor="@color/line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/tripVehicle" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="ABC-123" android:textColor="@color/ink" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:id="@+id/tripStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SCHEDULED" android:textColor="@color/green" android:textSize="9sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/tripRoute" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Origin → Destination" android:textColor="@color/ink" android:textSize="12sp" android:layout_marginTop="10dp" />
        <TextView android:id="@+id/tripDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Driver · Cargo · Distance" android:textColor="@color/muted" android:textSize="10sp" android:layout_marginTop="5dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/tripAction"
            android:layout_width="wrap_content" android:layout_height="40dp" android:text="Start trip"
            android:textAllCaps="false" android:textSize="11sp" android:layout_marginTop="12dp"
            android:visibility="gone" app:cornerRadius="11dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
