<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent"
    android:layout_height="wrap_content" android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/white" app:cardCornerRadius="16dp" app:cardElevation="0dp"
    app:strokeColor="@color/line" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="15dp">
        <View android:layout_width="4dp" android:layout_height="48dp" android:background="@color/teal" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:orientation="vertical" android:paddingStart="13dp">
            <TextView android:id="@+id/vehiclePlate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="ABC-123" android:textColor="@color/ink" android:textStyle="bold" android:textSize="15sp" />
            <TextView android:id="@+id/vehicleMeta" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Truck · 1,000 kg · Fuel 90%" android:textColor="@color/muted" android:textSize="11sp" android:layout_marginTop="4dp" />
            <TextView android:id="@+id/vehicleLocation" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="14.3294, 120.9367" android:textColor="@color/muted" android:textSize="10sp" android:layout_marginTop="3dp" />
        </LinearLayout>
        <TextView android:id="@+id/vehicleStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="IDLE" android:textColor="@color/green" android:textSize="9sp" android:textStyle="bold"
            android:background="@drawable/bg_teal_pill" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="6dp" android:paddingBottom="6dp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
